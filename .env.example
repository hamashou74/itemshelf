# Copy this file to .env before starting the self-host Compose stack.
# Keep .env private and do not commit it.

# This value is interpolated into DATABASE_URL, so use URL-safe characters.
# Example: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate separate random values for these secrets.
# Example: openssl rand -hex 32
DJANGO_SECRET_KEY=
# Must be at least 32 characters.
SESSION_SECRET=

# The frontend is host-local by default. Put a trusted HTTPS ingress in front
# before exposing Itemshelf beyond the local machine.
ITEMSHELF_BIND_ADDRESS=127.0.0.1
ITEMSHELF_PORT=3000
